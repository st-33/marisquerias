{
  "name": "marisquerias",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "NODE_OPTIONS=\"--max-old-space-size=8192\" EXPO_ROUTER_APP_ROOT=app expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "EXPO_ROUTER_APP_ROOT=app expo start --web",
    "lint": "expo lint",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "verify": "npm run lint && npm run check-types && npm test",
    "test": "jest",
    "enviar": "./enviar.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@types/lodash": "^4.17.21",
    "expo": "^57.0.9",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.14.0",
    "lodash": "^4.17.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-ble-plx": "^3.5.0",
    "react-native-bluetooth-classic": "^1.73.0-rc.15",
    "react-native-chart-kit": "^6.12.0",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.56.1",
    "@types/jest": "29.5.14",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "chromium-edge-launcher": "^0.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "expo-module-scripts": "^5.0.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.56.1",
    "prettier": "^3.8.4",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
