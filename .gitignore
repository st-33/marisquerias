*.keystore
*.properties
e2e-report/
test-results/

# Ignore Android prebuild generated files
android/app/src/main/java/com/anonymous/
android/app/src/main/res/mipmap-*/*.webp
android/app/src/main/res/mipmap-anydpi-v26/
android/app/src/main/res/values-night/

expo-env.d.ts
# @end expo-cli

# database dumps and static reports
*rtdb*.json
eslint_report.json