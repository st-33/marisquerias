{
  "rules": {
    ".read": false,
    ".write": false,

    "codigo_de_acceso": {
      "$codigo": {
        ".read": true,
        ".write": false,
        ".validate": "newData.isString() || newData.hasChildren(['slug_categoria', 'negocio_id']) || newData.hasChildren(['rutaNegocio'])"
      }
    },

    "codigo_acceso": {
      "$codigo": {
        ".read": true,
        ".write": false
      }
    },

    "categorias": {
      "$slug": {
        "plantilla_base": {
          ".read": true,
          ".write": false
        },
        "negocios_derivados": {
          "$negocioId": {
            ".read": true,
            ".write": false
          }
        }
      }
    },

    "plantillas": {
      "$slug": {
        ".read": true,
        ".write": false
      }
    },

    "negocios": {
      "$negocioId": {
        ".read": "auth != null",
        ".write": "auth != null",

        "configuracion": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "flags": {
          ".read": "auth != null",
          ".write": false
        },

        "dispositivos": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['rol']) || data.exists()",
            "rol": {
              ".validate": "newData.isString()"
            }
          }
        },

        "menu": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "mesas": {
          "$mesaId": {
            "estado": {
              ".validate": "newData.isString() && (newData.val() == 'libre' || newData.val() == 'ocupada' || newData.val() == 'cuenta')"
            }
          }
        },

        "mesas_pendientes": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "pedidos": {
          ".indexOn": ["estatus", "mesaId", "cuentaSolicitada", "cerrado"],
          "$pedidoId": {
            "estatus": {
              ".validate": "newData.isString() && (newData.val() == 'creado' || newData.val() == 'enviado_cocina' || newData.val() == 'en_preparacion' || newData.val() == 'listo_para_entregar' || newData.val() == 'entregado' || newData.val() == 'cerrado')"
            },
            "tipo": {
              ".validate": "newData.isString() && (newData.val() == 'mesa' || newData.val() == 'para_llevar' || newData.val() == 'delivery')"
            },
            "items": {
              "$itemId": {
                "cantidad": {
                  ".validate": "newData.isNumber() && newData.val() > 0"
                }
              }
            }
          }
        },

        "inventario": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "ventas": {
          "$ventaId": {
            ".validate": "newData.hasChild('total')",
            "total": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },

        "tickets": {
          "$ticketId": {
            ".validate": "newData.hasChildren()"
          }
        },

        "reparto_ajustes": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "marisquerias": {
      "Negocio principal de categoría": {
        ".read": true,
        ".write": false
      },
      "$negocioId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
