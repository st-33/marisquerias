{
  "rules": {
    ".read": false,
    ".write": false,

    "access_codes": {
      "$code": {
        ".read": true,
        ".write": false
      }
    },

    "2 alimentos_y_bebidas": {
      "marisquerias": {
        "$negocioId": {
          ".read": true,
          ".write": true,

          "dispositivos": {
            "$deviceId": {
              ".validate": "data.exists()",
              "rol": { ".validate": "newData.val() === data.val()" },
              "isAdmin": { ".validate": "newData.val() === data.val()" }
            }
          },

          "pedidos": {
            ".indexOn": ["estatus", "mesaId", "cuentaSolicitada", "cerrado"]
          }
        }
      }
    },

    "negocios": {
      "$negocioId": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
